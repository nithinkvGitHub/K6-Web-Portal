{
  "name": "Standard Strict Release Gates",
  "gates": [
    { "metric": "e2e_p95_ms", "op": "<=", "value": 10000, "label": "E2E Latency p95 <= 10s" },
    { "metric": "ttft_p95_ms", "op": "<=", "value": 2000, "label": "TTFT p95 <= 2s" },
    { "metric": "http_error_rate", "op": "<=", "value": 0.01, "label": "HTTP Error Rate <= 1%" },
    { "metric": "timeout_rate", "op": "<=", "value": 0.01, "label": "Timeout Rate <= 1%" },
    { "metric": "completion_rate", "op": ">=", "value": 0.98, "label": "Completion Rate >= 98%" },
    { "metric": "deterministic_pass_rate", "op": ">=", "value": 0.95, "label": "Deterministic Pass Rate >= 95%" },
    { "metric": "correctness_avg", "op": ">=", "value": 0.85, "label": "Correctness Score >= 0.85" },
    { "metric": "groundedness_avg", "op": ">=", "value": 0.85, "label": "Groundedness Score >= 0.85" },
    { "metric": "critical_failures", "op": "==", "value": 0, "label": "Zero Critical Safety Failures" },
    { "metric": "qdul_pct_max", "op": "<=", "value": 5, "label": "Quality Drop Under Load (QDUL) <= 5%" }
  ]
}
